// Gladiator Gym — Prisma schéma (Fáza 1)
//
// Web zatiaľ renderuje obsah z lib/gym.ts a lib/pricing.ts (jediný zdroj
// pravdy bez CMS). Tabuľky Pobocka/Trener/Sluzba/Cennik/Clen sú pripravené
// na neskoršiu správu obsahu a členské účty — Fáza 1 do nich nezapisuje.
// Aktívne používané: Objednavka (Stripe platby) a Dopyt (rezervácie/kontakt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: DATABASE_URL = pooler (pgbouncer, port 6543) pre runtime,
  // DIRECT_URL = priame pripojenie (port 5432) pre `prisma migrate`.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ObjednavkaStav {
  PENDING
  PAID
  FAILED
}

// Pripravené pre neskoršie uplatnenie vstupu (Fáza 1 nezapisuje):
// EMAIL = ručné overenie na recepcii, QR / CHIP prídu neskôr.
enum RedemptionMethod {
  EMAIL
  QR
  CHIP
}

enum ProduktTyp {
  VSTUP
  PERMANENTKA
  BALIK
  INE
}

enum DopytTyp {
  REZERVACIA
  KONTAKT
}

// ── Fáza 2 (členský QR systém) — pripravené, zatiaľ NEPOUŽÍVANÉ ──────────

enum PermanentkaStav {
  AKTIVNA
  EXPIROVANA
  ZRUSENA
}

enum SposobVstupu {
  QR
  RUCNE
}

model Pobocka {
  id        String   @id @default(cuid())
  kluc      String   @unique // "lucenec"
  nazov     String
  adresa    String?
  telefon   String?
  email     String?
  aktivna   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treneri     Trener[]
  sluzby      Sluzba[]
  cennik      Cennik[]
  clenovia    Clen[]
  permanentky Permanentka[]
  vstupy      VstupHistoria[]
}

model Trener {
  id        String   @id @default(cuid())
  slug      String   @unique
  meno      String
  bio       String?
  foto      String? // URL/cesta k fotke — zatiaľ placeholder
  aktivny   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pobockaId String?
  pobocka   Pobocka? @relation(fields: [pobockaId], references: [id])
}

model Sluzba {
  id        String   @id @default(cuid())
  slug      String   @unique
  nazov     String
  popis     String?
  aktivna   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pobockaId String?
  pobocka   Pobocka? @relation(fields: [pobockaId], references: [id])
}

model Cennik {
  id              String     @id @default(cuid())
  kluc            String     @unique // napr. "vstup-jednorazovy"
  nazov           String
  popis           String?
  typ             ProduktTyp
  cenaCenty       Int? // null = cena na vyžiadanie
  mena            String     @default("eur")
  kupitelneOnline Boolean    @default(false)
  platnost        String? // napr. "2 mesiace"
  poznamka        String?
  poradie         Int        @default(0)
  aktivna         Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  pobockaId String?
  pobocka   Pobocka? @relation(fields: [pobockaId], references: [id])
}

// Členský účet — rozšírený pre PWA v1 (auth, rebríček, výzvy, audit).
// email/authUserId/prezyvkaNorm sú tri nezávislé unikátne stĺpce.
model Clen {
  id           String   @id @default(cuid())
  authUserId   String?  @unique @db.Uuid // väzba na auth.users.id (bez Prisma relácie)
  email        String?  @unique // zdroj pravdy je auth.users; tu voliteľne
  prezyvka     String? // zobrazovaná podoba, napr. "Gladiator"
  prezyvkaNorm String?  @unique // malé písmená bez diakritiky — nastavuje server
  rola         Rola     @default(CLEN)
  aktivny      Boolean  @default(true)
  meno         String?
  telefon      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pobockaId  String?
  pobocka    Pobocka?     @relation(fields: [pobockaId], references: [id], onDelete: SetNull)
  objednavky Objednavka[]

  // Fáza 2 — členský QR systém (tabuľky ostávajú prázdne do Fázy 2)
  permanentky Permanentka[]
  qrTokeny    QRToken[]
  vstupy      VstupHistoria[]

  // PWA v1 — osobné rekordy, zápisy do výziev a audit stopa
  rekordy         Rekord[]     @relation("RekordyClena")
  posudeneRekordy Rekord[]     @relation("PosudeneRekordy")
  zapisy          VyzvaZapis[] @relation("ZapisyClena")
  posudeneZapisy  VyzvaZapis[] @relation("PosudeneZapisy")
  adminLogy       AdminLog[]

  @@index([rola, aktivny])
}

model Objednavka {
  id              String         @id @default(cuid())
  cisloObjednavky String         @unique // napr. "GLD-20260718-A7K2"
  meno            String?
  email           String?
  produktKluc     String
  produktNazov    String
  produktTyp      ProduktTyp
  suma            Int // v centoch
  mena            String         @default("eur")
  stav            ObjednavkaStav @default(PENDING)

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  // Pripravené pre QR/čip fázu — Fáza 1 tieto polia nezapisuje ani nečíta.
  // Doplnenie logiky neskôr NEVYŽADUJE migráciu meniacu existujúce dáta.
  redemptionMethod RedemptionMethod?
  redeemedAt       DateTime?

  // TODO Fáza 2: po stave PAID vytvoriť/predĺžiť Permanentku pre priradeného Clen
  clenId String?
  clen   Clen?   @relation(fields: [clenId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stav, createdAt])
}

// ── Fáza 2 modely — čisto schéma, žiadna logika ani API (tabuľky prázdne) ──

// Členská permanentka — vznikne z PAID objednávky (viď TODO v Objednavka).
model Permanentka {
  id         String          @id @default(cuid())
  typ        String // kľúč položky cenníka (napr. "permanentka-mesacna")
  platnostOd DateTime
  platnostDo DateTime
  stav       PermanentkaStav @default(AKTIVNA)
  createdAt  DateTime        @default(now())

  clenId    String
  clen      Clen    @relation(fields: [clenId], references: [id], onDelete: Cascade)
  pobockaId String
  pobocka   Pobocka @relation(fields: [pobockaId], references: [id])

  @@index([clenId, stav])
}

// Jednorazový QR token pre vstup (krátka expirácia, jedno použitie).
model QRToken {
  id          String   @id @default(cuid())
  token       String   @unique
  vytvorenyAt DateTime @default(now())
  expirujeO   DateTime
  pouzity     Boolean  @default(false)

  clenId String
  clen   Clen   @relation(fields: [clenId], references: [id], onDelete: Cascade)

  @@index([clenId, pouzity])
}

// História vstupov — QR čítačka aj ručné overenie na recepcii.
model VstupHistoria {
  id       String       @id @default(cuid())
  datumCas DateTime     @default(now())
  sposob   SposobVstupu
  uspesny  Boolean

  clenId    String
  clen      Clen    @relation(fields: [clenId], references: [id], onDelete: Cascade)
  pobockaId String
  pobocka   Pobocka @relation(fields: [pobockaId], references: [id])

  @@index([clenId, datumCas])
}

// Zber dopytov z formulárov (rezervácia = zatiaľ len dopyt bez automatického
// potvrdzovania termínu; kontaktný formulár).
model Dopyt {
  id               String   @id @default(cuid())
  typ              DopytTyp
  meno             String
  email            String
  telefon          String?
  sprava           String?
  sluzba           String? // slug služby pri rezervácii
  terminPozadovany String? // voľný text — bez automatického potvrdzovania
  vybaveny         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([typ, vybaveny, createdAt])
}

// ══ PWA v1 — členská zóna (rebríček, výzvy, audit) ═══════════════════════

enum Rola {
  CLEN
  ADMIN
}

enum Jednotka {
  KG
  OPAKOVANIA
  SEKUNDY
}

enum VyzvaStav {
  NAVRH
  AKTIVNA
  UZAVRETA
}

enum VysledokStav {
  SUKROMNY
  CAKA
  SCHVALENE
  ZAMIETNUTE
}

// Cvik — merateľný cvik do rebríčka/výzvy; jednotka určuje zobrazenie a porovnanie.
model Cvik {
  id        String   @id @default(cuid())
  slug      String   @unique
  nazov     String
  popis     String?
  jednotka  Jednotka
  aktivny   Boolean  @default(true)
  poradie   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rekordy Rekord[]
  vyzvy   Vyzva[]

  @@index([aktivny, poradie])
}

// Rekord — osobný rekord člena v cviku; SUKROMNY kým ho člen sám neprihlási do rebríčka.
model Rekord {
  id               String       @id @default(cuid())
  clenId           String
  cvikId           String
  hodnota          Decimal      @db.Decimal(8, 2)
  dosiahnute       DateTime     @db.Date
  poznamka         String?
  stav             VysledokStav @default(SUKROMNY)
  posudilId        String?
  posudene         DateTime?
  dovodZamietnutia String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  clen    Clen  @relation("RekordyClena", fields: [clenId], references: [id], onDelete: Cascade)
  cvik    Cvik  @relation(fields: [cvikId], references: [id], onDelete: Restrict)
  posudil Clen? @relation("PosudeneRekordy", fields: [posudilId], references: [id], onDelete: SetNull)

  @@index([clenId, cvikId, dosiahnute])
  @@index([cvikId, stav, hodnota])
}

// Vyzva — časovo ohraničená súťaž v jednom cviku (jedna aktívna rieši aplikácia, nie DB).
model Vyzva {
  id        String    @id @default(cuid())
  slug      String    @unique
  nazov     String
  popis     String?
  cvikId    String
  zaciatok  DateTime  @db.Date
  koniec    DateTime  @db.Date
  stav      VyzvaStav @default(NAVRH)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cvik   Cvik         @relation(fields: [cvikId], references: [id], onDelete: Restrict)
  zapisy VyzvaZapis[]

  @@index([stav, zaciatok])
}

// VyzvaZapis — zápis člena do výzvy; jeden na člena a výzvu (vynútené DB).
model VyzvaZapis {
  id               String       @id @default(cuid())
  vyzvaId          String
  clenId           String
  hodnota          Decimal      @db.Decimal(8, 2)
  stav             VysledokStav @default(CAKA)
  posudilId        String?
  posudene         DateTime?
  dovodZamietnutia String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vyzva   Vyzva @relation(fields: [vyzvaId], references: [id], onDelete: Cascade)
  clen    Clen  @relation("ZapisyClena", fields: [clenId], references: [id], onDelete: Cascade)
  posudil Clen? @relation("PosudeneZapisy", fields: [posudilId], references: [id], onDelete: SetNull)

  @@unique([vyzvaId, clenId])
  @@index([vyzvaId, stav, hodnota])
}

// AdminLog — audit stopa admin akcií; iba zápis, prezývka uložená ako snapshot (prežije výmaz účtu).
model AdminLog {
  id            String   @id @default(cuid())
  aktorId       String?
  aktorPrezyvka String
  akcia         String
  cielTyp       String
  cielId        String?
  detail        Json?
  createdAt     DateTime @default(now())

  aktor Clen? @relation(fields: [aktorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([aktorId, createdAt])
}
